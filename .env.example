# Copia este archivo a ".env" y completa los valores reales.
# ".env" nunca se sube a git (está en .gitignore).

# Credenciales de CargoLink (usadas por app.py al generar el reporte)
CARGOLINK_USUARIO=
CARGOLINK_PASSWORD=

# Cadena de conexión a Postgres (Supabase). Local: puede ser la conexión
# directa (puerto 5432). En Vercel: usa el modo "Transaction pooler"
# (puerto 6543) para no agotar las conexiones disponibles.
DATABASE_URL=

# Clave para firmar las sesiones de Flask. Si se deja vacía, se genera una
# aleatoria en cada arranque del proceso (las sesiones no sobreviven un
# reinicio/cold start). En Vercel, defínela siempre.
SECRET_KEY=

# El login valida contra el catálogo de accesos de Seguimiento de
# Importaciones (auth.users + app_user_permissions), en el mismo Postgres de
# arriba. Los usuarios se dan de alta ahí (Catálogos → Accesos), no aquí.

# URL pública de Seguimiento de Importaciones (Next.js), para el enlace de
# navegación cruzada en el menú. Default: http://localhost:3001 (dev local).
IMPORTACIONES_URL=

# Secreto que protege /cron/generar-reporte (la actualización automática
# diaria). Vercel lo manda solo como header Authorization en sus propias
# llamadas de Cron Jobs si la variable se llama exactamente CRON_SECRET.
CRON_SECRET=

# Zona horaria para mostrar horas y calcular "hoy" (ej. en el cron).
TZ_LOCAL=America/Mexico_City
