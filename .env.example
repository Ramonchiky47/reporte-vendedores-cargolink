# Copia este archivo a ".env" y completa los valores reales.
# ".env" nunca se sube a git (está en .gitignore).

# Credenciales de CargoLink (usadas por app.py al generar el reporte)
CARGOLINK_USUARIO=
CARGOLINK_PASSWORD=

# Cadena de conexión a Postgres (Supabase). Local: puede ser la conexión
# directa (puerto 5432). En Vercel: usa el modo "Transaction pooler"
# (puerto 6543) para no agotar las conexiones disponibles.
DATABASE_URL=

# Clave para firmar las sesiones de Flask. Si se deja vacía, se genera una
# aleatoria en cada arranque del proceso (las sesiones no sobreviven un
# reinicio/cold start). En Vercel, defínela siempre.
SECRET_KEY=

# Opcionales: crean un primer usuario administrador automáticamente si la
# tabla de usuarios está vacía. Solo hacen algo la primera vez.
INITIAL_ADMIN_USER=
INITIAL_ADMIN_PASSWORD=
