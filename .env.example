# Copia este archivo a ".env" y completa los valores reales.
# ".env" nunca se sube a git (está en .gitignore).

# Credenciales de CargoLink (las usa descargar_reporte.py)
CARGOLINK_USUARIO=
CARGOLINK_PASSWORD=

# Clave para firmar las sesiones de Flask. Si se deja vacía, la app genera
# una automáticamente y la guarda en DATA_DIR/.secret_key.
SECRET_KEY=

# Carpeta donde se guardan la base de datos SQLite y los reportes
# descargados. En Railway debe apuntar a la ruta del Volume (ej. /data).
# En local, si se deja vacía, usa la propia carpeta webapp/.
DATA_DIR=
