{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/cron/generar-reporte",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/cron/generar-reporte",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/cron/reporte-ejecutivo",
      "schedule": "0 14 * * 1"
    }
  ],
  "regions": [
    "sfo1"
  ]
}
